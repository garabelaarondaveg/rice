Xcursor.theme: Fluent-dark-cursors
Xcursor.size: 24
URxvt.font: xft:Fira Code:pixelsize=14:antialias=true
!URxvt.boldFont: xft:
!URxvt.italicFont: xft:DejaVu Sans Mono:pixelsize=15,style=Book
!URxvt.boldItalicfont: xft:DejaVu Sans Mono:pixelsize=15,style=Book
URxvt.letterSpace: 0
URxvt.lineSpace: 0
URxvt.geometry: 92x24
!URxvt.internalBorder: 24
URxvt.internalBorder: 4
URxvt.cursorBlink: true
URxvt.cursorUnderline: false
URxvt.saveline: 2048
URxvt.scrollBar: false
URxvt.scrollBar_right: false
URxvt.urgentOnBell: true
URxvt.depth: 24
URxvt.iso14755: false

!! URxvt Functions
URxvt.perl-ext-common: font-size,selection-to-clipboard,pasta
URxvt.keysym.Control-C:    perl:keyboard-select:activate
URxvt.keysym.Control-V:    perl:pasta:paste
! Comment this if you don't want copy when text is selected
URxvt.clipboard.autocopy: true
URxvt.keysym.C-j:       perl:font-size:increase
URxvt.keysym.C-k:       perl:font-size:decrease

